APP_ENV=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://localhost:5432/memorycard
REDIS_URL=redis://localhost:6379/0

DEEPGRAM_API_KEY=

LLM_MODEL=vertex_ai/gemini-2.5-flash
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=30
LLM_NUM_RETRIES=2
LLM_STREAMING=true
LLM_EXTRA_PARAMS={"vertex_project": "your-project", "vertex_location": "asia-south1"}
# Either the JSON contents of a Google credentials file or a path to it.
VERTEX_CREDENTIALS=
# Latency budget (seconds) for one spoken host line before falling back to a canned line.
HOST_LINE_TIMEOUT=4
# Only needed if LLM_MODEL is an AI Studio model such as gemini/gemini-2.5-flash
GEMINI_API_KEY=
